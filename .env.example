# === Identifiants UPS ===
# Créés sur https://developer.ups.com > Apps
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Numéro de compte UPS (6 caractères). Requis pour Rating négocié et Shipping.
UPS_ACCOUNT_NUMBER=

# === Environnement ===
# "test" -> https://wwwcie.ups.com (CIE, bac à sable)
# "production" -> https://onlinetools.ups.com
UPS_ENV=test

# === Base de données (historique des envois) ===
# UPS ne propose aucune API pour lister les expéditions déjà créées :
# elles sont enregistrées localement pour alimenter la page "Envois en cours".
# Si cette variable est vide, l'application fonctionne mais sans historique.
DATABASE_URL=postgresql://user:password@hote:5432/ups
# true pour une base managée exigeant TLS (Neon, Supabase…),
# false en réseau interne Coolify.
DATABASE_SSL=false

# === Détection d'anomalies (seuils en jours) ===
# Colis en transit sans aucun mouvement.
ANOMALY_STALLED_DAYS=3
# Étiquette créée mais colis jamais scanné par UPS.
ANOMALY_NEVER_PICKED_UP_DAYS=2
# Repli quand UPS n'a pas fourni de date de livraison prévue.
ANOMALY_FALLBACK_DELAY_DAYS=7

# === Serveur ===
PORT=3000
# Origines autorisées pour le CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# === Adresse expéditeur par défaut (utilisée par Rating / Shipping) ===
SHIPPER_NAME=Ma Societe
SHIPPER_ATTENTION_NAME=Service Expedition
SHIPPER_PHONE=0102030405
SHIPPER_ADDRESS_LINE=1 rue de la Paix
SHIPPER_CITY=Paris
SHIPPER_POSTAL_CODE=75002
SHIPPER_STATE=
SHIPPER_COUNTRY=FR
